<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.whisperown.archive</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/archive-recordings.sh</string>
    </array>

    <!-- Sundays at 04:00 local time. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/whisperown-archive.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/whisperown-archive.log</string>
</dict>
</plist>
